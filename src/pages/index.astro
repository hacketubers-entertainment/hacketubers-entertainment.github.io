---
import Layout from "../layouts/Layout.astro";
import BannerPrincipal from "../components/BannerPrincipal.astro";
import ContRedesSociales from "../components/containers/ContRedesSociales.astro";
import ContProyects from "../components/containers/ContProyects.astro";
import About from "../components/About.astro";
import ContStatsSocials from "../components/containers/contStatsSocials.astro";
import {indexProjects} from "../constants/projects"
---

<Layout>
  <BannerPrincipal />
  <ContRedesSociales />
  <ContProyects subtitulo="Proyectos" projectList={indexProjects}/>
  <About />
  <ContStatsSocials />
</Layout>
